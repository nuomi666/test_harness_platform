# ======================================================
# 测试资产智能生成平台 - 环境变量配置模板
# ======================================================
# 使用方式：
#   1. 复制本文件为 .env
#   2. 填入你的真实 API Key
#   3. .env 已在 .gitignore 中，不会被提交
# ======================================================

# ---------- 通用配置 ----------
ENV=dev
SERVICE_PORT=8000
VECTOR_DB_PATH=./chroma_db
UPLOAD_DIR=./temp_documents
LLM_TEMPERATURE=0.3
LLM_SEGMENT_SIZE=8

# ---------- 思考开关 / 输出上限 ----------
# 思考型模型（doubao-seed-2.x、deepseek-v4 系列等）默认开启深度思考，且 reasoning_tokens
# 计入 max_tokens ⇒ 长 prompt 会把输出预算全花在思考链上，正文为空（finish_reason=length）。
# 因此默认关闭思考；确需深度推理时改成 enabled / auto（也可在单次调用里覆盖）。
LLM_THINKING_TYPE=disabled
# 输出上限保持 8192：关思考后已覆盖当前各调用场景；被截断时日志会告警、正文为空会直接报错。
# LLM_MAX_TOKENS=8192

# ---------- 评审线输入预算（防上下文超限）----------
# 上传文本上限（字数）：解析后的文档文本会拼进评审 prompt（评审链会送 3 次），过长会顶爆上下文窗口。
MAX_UPLOAD_TEXT_CHARS=50000
# 单次评审输入总预算（字数，中文按 1 字 ≈ 1 token 估算）：超预算按
# 「历史评审 → 用例精简档位 → 模块规则 → 文档截断 → 通用规则」顺序裁剪，
# 并回传裁剪明细供前端展示。
MAX_REVIEW_INPUT_CHARS=80000

# ---------- 上传大小上限（防内存打爆 / 超大文件）----------
# /upload 单文件字节上限，默认 20MB；超限直接回 413 且不落盘。
MAX_UPLOAD_BYTES=20971520

# ---------- 用例质量评审（case-quality-scorer）----------
# 引擎 B（LLM rubric 打分）每片用例数；输出为紧凑 JSON，12 条约 3k token，安全
CASE_SCORE_SEGMENT_SIZE=12
# 分档阈值：≥85 保留 / 60~84 待改进 / <60 或命中高危硬伤 → 建议删除（人工确认后才生效）
CASE_SCORE_KEEP_THRESHOLD=85
CASE_SCORE_DELETE_THRESHOLD=60
# 跨批次重评时，总分变化超过此值标「分数漂移」待人工看
CASE_SCORE_DRIFT_DELTA=15
# A5 语义重复的 L2 距离阈值（越小越相似；仅提示不参与删留，实测后再调）
CASE_SCORE_DUP_DISTANCE=0.6

# ---------- LLM 类型（必选其一，注释其他方案） ----------

# 【方案1】通义千问 DashScope
# LLM_TYPE=dashscope
# LLM_API_KEY=你的通义千问KEY
# LLM_MODEL=qwen-plus

# 【方案2】OpenAI GPT（兼容模式）
# LLM_TYPE=openai
# LLM_API_KEY=你的OPENAI_API_KEY
# LLM_MODEL=gpt-3.5-turbo
# OPENAI_BASE_URL=https://api.openai.com/v1

# 【方案3】火山方舟 Doubao（OpenAI 兼容模式，推荐）
LLM_TYPE=doubao
LLM_API_KEY=请填入你的火山方舟 API Key
LLM_MODEL=请填入你的模型接入ID（ep-xxx 开头）
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---------- 可选：截图 OCR ----------
# 说明：OCR 能力需要本机已安装 Tesseract 引擎
# Windows 安装：https://github.com/UB-Mannheim/tesseract/wiki
# 安装后将 tesseract.exe 路径写入 image_ocr.py 中的 pytesseract.tesseract_cmd
# 未安装时图片上传走降级逻辑，不影响其他功能

# ---------- 可选：Embedding 模型选择 ----------
# 1（默认）：sentence-transformers PyTorch 版 all-MiniLM-L6-v2（384 维）
#           本地缓存：~/.cache/huggingface/hub/models--sentence-transformers--all-MiniLM-L6-v2/
#           中文效果略好；支持 HF_HUB_OFFLINE=1 零网络启动
# 0：        ChromaDB 自带 ONNX 版 all-MiniLM-L6-v2，体积小（~80MB）
#           本地缓存：~/.cache/chroma/onnx_models/all-MiniLM-L6-v2/
#           注意：本机 ONNX 模型可能损坏，若加载失败切回 1
# USE_SENTENCE_TRANSFORMERS=1